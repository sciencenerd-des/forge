# ─────────────────────────────────────────────────────────────────────────────
# Forge configuration — copy to .env and edit. Every value has a working default;
# nothing here is required to get started with the bundled docker-compose stack.
# ─────────────────────────────────────────────────────────────────────────────

# ── Paths ────────────────────────────────────────────────────────────────────
# Writable home for state, logs, and per-project workspaces.
FORGE_HOME=~/.forge
# Where the loop creates each project's working directory.
# FORGE_WORKSPACES=~/.forge/workspaces
# SQLite gateway/state mirror + tool-docs DB (sane defaults under FORGE_HOME / repo).
# FORGE_STATE_DB=~/.forge/state.db
# FORGE_TOOLDOCS_DB=./tools_db/tool_docs.db

# ── Databases ────────────────────────────────────────────────────────────────
# Engine database — Postgres (the engine uses ARRAY columns). Matches docker-compose.
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge
# Control-plane (GUI) database — lightweight, SQLite by default.
# FORGE_CONTROL_DATABASE_URL=sqlite:///./forge-control.db

# ── Default project ──────────────────────────────────────────────────────────
# Pin a project UUID, or leave unset to resolve/create a "default" project.
# FORGE_DEFAULT_PROJECT=

# ── Model provider (any OpenAI-compatible backend) ───────────────────────────
# Defaults target a local LM Studio. Point these at Ollama, vLLM, or a cloud API.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-4-12b-qat
FORGE_LLM_API_KEY=not-needed
FORGE_LLM_TIMEOUT=300

# Per-role model routing (a coding specialist on the workers, a generalist on the
# rest). Each falls back to LLM_MODEL when unset.
# PGE_PLANNER_MODEL=
# PGE_EXECUTOR_MODEL=
# PGE_AUDITOR_MODEL=
# PGE_EVALUATOR_MODEL=
# PGE_STEWARD_MODEL=
# Steward base_url (defaults to LLM_BASE_URL; set for a split-brain second server):
# PGE_STEWARD_BASE_URL=http://127.0.0.1:1234/v1
# Per-role base_url override (e.g. a second server for the coder):
# FORGE_EXECUTOR_BASE_URL=http://localhost:1235/v1

# ── Second set of eyes: free cloud models for the auditor/evaluator ──────────
# The executor's local model writes the code; having the auditor (derives
# the contract) and evaluator (interprets failures) reason with a DIFFERENT,
# stronger model with fresh context catches mistakes a single model repeats
# on itself. Zero-cost options, tried in order until one works:
#
#   1. Ollama free cloud tier — run `ollama signin` once, then any
#      `<model>:cloud` name (e.g. gpt-oss:120b-cloud, qwen3-coder:480b-cloud,
#      deepseek-v3.1:671b-cloud) routes through your LOCAL Ollama daemon to
#      Ollama's cloud infra for free. No API key needed once signed in.
#   2. Codex (engine/src/auditor.py CODEX_FALLBACK, on by default) — shells
#      out to `hermes chat --provider openai-codex`, using whatever ChatGPT/
#      Codex CLI session is already logged in (`codex login`).
#   3. Local model — final fallback so the loop never blocks on a cloud
#      outage or rate limit.
#
# PGE_EVALUATOR_MODEL=gpt-oss:120b-cloud
# PGE_AUDITOR_MODELS=gpt-oss:120b-cloud,qwen3-coder:480b-cloud
# PGE_AUDITOR_CODEX=1
# PGE_AUDITOR_CODEX_MODEL=gpt-5.5
#
# Alternative: a free OpenRouter model (https://openrouter.ai/models?max_price=0)
# works too — point LLM_BASE_URL at https://openrouter.ai/api/v1, set
# FORGE_LLM_API_KEY to an OpenRouter key, and use a free-tier model id
# (e.g. LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free) for any single role.

# Example — cloud (OpenAI):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# FORGE_LLM_API_KEY=sk-...        # never commit a real key

# ── Context autocompaction + KV-cache pruning ───────────────────────────────
# The executor transcript is compacted past a token threshold (older tool
# chatter folded into a salvage summary keeping errors/commands/paths), and
# the Ollama model is unloaded at regular batch boundaries to release its KV
# cache (observed growing 7.7GB -> 17GB at num_ctx=200k, exhausting host
# swap). num_ctx is never reduced.
# PGE_CONTEXT_COMPACT_THRESHOLD=12000   # est. tokens before compaction
# PGE_CONTEXT_COMPACT_KEEP=6            # recent messages always kept verbatim
# PGE_KV_PRUNE_INTERVAL=4               # prune every N batches; 0 disables

# ── Loop control (advanced) ──────────────────────────────────────────────────
# PGE_MAX_TURNS=24                 # per-batch turn cap
# PGE_MAX_CONSECUTIVE_FAILURES=6   # batches survived (transient OR node-level) before giving up
# PGE_MAX_STAGNANT_BATCHES=2       # no-progress batches before stopping
# PGE_MAX_SEMANTIC_BLOCKS=4        # identical semantic-gate completion blocks before
#                                  # stopping (catches test-weakening thrash that byte
#                                  # fingerprints can't see — the workspace keeps changing)

# ── Control plane / web ──────────────────────────────────────────────────────
# FORGE_CONTROL_HOST=127.0.0.1
# FORGE_CONTROL_PORT=8787
# FORGE_CONTROL_URL=http://127.0.0.1:8787   # the web dev server proxies /api here
FORGE_CONTROL_TOKEN=forge-local-control

# Arbitrary model-proposed commands are disabled on the host by default. Prefer
# Docker. Set this only when you deliberately accept host filesystem access —
# and note the DEFAULT sandbox mode below already gives you container
# isolation without needing this at all.
# FORGE_ALLOW_HOST_EXECUTION=1

# ── Sandbox: the default execution environment (forge_runtime/sandbox.py) ───
# Every tool call (write_file/read_file/bash/install_deps/run_tests/...)
# executes inside a per-project Docker container by default: non-root
# (uid:gid 10001:10001), every capability dropped, no-new-privileges, and its
# files on a Docker-managed named volume — never a host bind-mount, so the
# sandbox has NO path back to the host filesystem. Requires Docker and fails
# closed if Docker or sandbox setup is unavailable. Host mode is an explicit
# operator opt-in and still keeps file paths contained to the project root.
#
# FORGE_SANDBOX_MODE=container      # "container" (default) | "host"
# To use host shell commands, also set FORGE_ALLOW_HOST_EXECUTION=1 after
# accepting the risk. Existing host workspaces import into a new sandbox volume
# once; result syncs stage and validate before replacing the host mirror.
# Generated-contract strength and mutation gates require container mode, so host
# mode defers verified completion instead of running model-generated probes here.
# FORGE_SANDBOX_IMAGE=forge-sandbox:latest   # build via: docker build -t forge-sandbox:latest -f docker/sandbox/Dockerfile .
# FORGE_SANDBOX_NETWORK=bridge      # network mode for the sandbox container (installs need it)
# FORGE_SANDBOX_READONLY_ROOTFS=0   # set 1 for extra hardening (read-only root fs, /tmp as tmpfs)
# Resource limits — a sandbox that can starve its judge isn't contained: an
# unbounded in-sandbox training loop once wedged the Docker daemon itself
# (host swap exhausted), hanging every audit test on the machine.
# FORGE_SANDBOX_MEMORY=3g
# FORGE_SANDBOX_MEMORY_SWAP=3g      # equal to MEMORY = no swap thrash
# FORGE_SANDBOX_CPUS=3
# FORGE_SANDBOX_PIDS=512

# ── Observability: OpenTelemetry (forge_runtime/telemetry.py) ────────────────
# Traces every PGE node (planner/auditor/executor/evaluator) and tool call,
# plus counters for tool invocations and completion-gate blocks. Exports via
# OTLP to a collector — `docker compose up -d otel-collector` then
# `docker compose logs -f otel-collector` to see spans, or point the
# collector's exporters (otel-collector-config.yaml) at Jaeger/Grafana/etc.
# Degrades to silently running without tracing if no collector is reachable —
# never blocks the loop.
#
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# FORGE_OTEL_ENABLED=1
